#!/usr/bin/env bash
# Pre-commit secret scanner for AuraVerify.
# Blocks commits whose *added* lines contain likely API keys, private keys,
# or the committer's own email address (e.g. a personal fallback recipient
# left in an n8n export — use you@example.com in the public copy instead).
#
# Enable once per clone:   git config core.hooksPath .githooks
# Block extra addresses:   git config --add hooks.blockedEmail someone@example.org
# False positive? Bypass a single commit with:   git commit --no-verify
#
# SECRET_SCAN_BASE=<tree-ish> scans the index against that base instead of HEAD
# (e.g. the empty tree 4b825dc642cb6eb9a060e54bf8d69288fbee4904 to scan every tracked file).

set -u

# "Label|flags|extended-regex"   (flags: i = case-insensitive)
patterns=(
  "Tavily API key||tvly-[A-Za-z0-9_-]{20,}"
  "Anthropic API key||sk-ant-[A-Za-z0-9_-]{20,}"
  "OpenAI API key||sk-(proj|svcacct|admin)-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{32,}"
  "GitHub token||gh[pousr]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}"
  "AWS access key||(AKIA|ASIA)[0-9A-Z]{16}"
  "Google API key||AIza[0-9A-Za-z_-]{35}"
  "Slack token||xox[abposr]-[A-Za-z0-9-]{10,}"
  "Stripe live key||(sk|rk)_live_[0-9A-Za-z]{24,}"
  "Private key block||-----BEGIN ([A-Z]+ )?PRIVATE KEY-----"
  "Hard-coded secret value|i|[\"']?(api[_-]?key|secret|token|password)[\"']?[[:space:]]*[:=][[:space:]]*[\"'][^\"'{}\$<>= ]{16,}[\"']"
)

# Emit "file:line:text" for every line added in the staged diff.
added=$(git diff --cached ${SECRET_SCAN_BASE:-} -U0 --no-color --no-ext-diff --diff-filter=ACMR | awk '
  /^diff --git /        { hdr = 1; next }
  hdr && /^\+\+\+ /     { f = substr($0, 7); next }
  /^@@/                 { hdr = 0; match($0, /\+[0-9]+/); n = substr($0, RSTART + 1, RLENGTH - 1); next }
  !hdr && /^\+/         { print f ":" n ":" substr($0, 2); n++ }
')

[ -z "$added" ] && exit 0

found=0

# Fail closed: if a scan step errors (e.g. a crashing grep), block the commit.
scan_error() {
  printf '  Scanner error while checking: %s (exit %s)\n' "$1" "$2" >&2
  found=1
}

# Print one finding. $1 = "file:line:matched-text", $2 = label, $3 = preview mode.
emit() {
  local file tmp line match preview
  file=${1%%:*}
  tmp=${1#*:}
  line=${tmp%%:*}
  match=${tmp#*:}
  if [ "$3" = email ]; then
    preview="$(printf '%s' "${match%%@*}" | cut -c1-3)…@${match#*@}"
  else
    preview="$(printf '%s' "$match" | cut -c1-12)…"
  fi
  printf '  %s:%s  %s  (%s)\n' "$file" "$line" "$2" "$preview" >&2
  found=1
}

# API key patterns (grep -E / -iE; note: Git for Windows' grep -iF crashes on non-ASCII input).
for entry in "${patterns[@]}"; do
  label=${entry%%|*}
  rest=${entry#*|}
  flags=${rest%%|*}
  re=${rest#*|}
  gflags=-E
  [ "$flags" = "i" ] && gflags=-iE
  hits=$(printf '%s\n' "$added" | grep $gflags -- "$re"); st=$?
  [ "$st" -gt 1 ] && { scan_error "$label" "$st"; continue; }
  while IFS= read -r hit; do
    [ -z "$hit" ] && continue
    tmp=${hit#*:}
    match=$(printf '%s\n' "${tmp#*:}" | grep $gflags -o -- "$re" | head -n1)
    emit "${hit%%:*}:${tmp%%:*}:$match" "$label" key
  done <<< "$hits"
done

# Personal email check: the committer's git user.email plus any hooks.blockedEmail
# entries. Read from local git config at run time so no address is stored in this file.
# Case-insensitive literal match done in awk (avoids the grep -iF crash).
while IFS= read -r email; do
  [ -z "$email" ] && continue
  case "$email" in *noreply*|*@example.com|*@example.org) continue ;; esac
  hits=$(printf '%s\n' "$added" | awk -v e="$email" '
    {
      p = index($0, ":"); rest = substr($0, p + 1); q = index(rest, ":")
      text = substr(rest, q + 1)
      i = index(tolower(text), tolower(e))
      if (i) print substr($0, 1, p + q) substr(text, i, length(e))
    }'); st=$?
  [ "$st" -ne 0 ] && { scan_error "personal email" "$st"; continue; }
  while IFS= read -r hit; do
    [ -z "$hit" ] && continue
    emit "$hit" "Personal email (use you@example.com)" email
  done <<< "$hits"
done <<< "$( { git config user.email; git config --get-all hooks.blockedEmail; } 2>/dev/null | sort -u )"

if [ "$found" -ne 0 ]; then
  {
    echo
    echo "✋ Commit blocked: possible secrets or personal data in the lines above."
    echo "   Move keys into n8n credentials / env vars, swap personal emails for you@example.com,"
    echo "   restage, and commit again."
    echo "   Definitely a false positive? Re-run with: git commit --no-verify"
  } >&2
  exit 1
fi
exit 0
